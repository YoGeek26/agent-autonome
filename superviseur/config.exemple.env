# Copier en /etc/agent.env, chmod 600, root:root.
# Aucune de ces valeurs ne doit se retrouver dans le dépôt.

AGENT_DEPOT=/opt/agent
AGENT_MODELE=claude-opus-5
AGENT_MAX_TOURS=150
AGENT_TIMEOUT=2700

# Cadence : bornes du battement de fond. L'agent choisit dans cet intervalle
# via etat/rythme.json. Descendre AGENT_BATTEMENT_MIN coûte cher.
AGENT_BATTEMENT_MIN=20
AGENT_BATTEMENT_MAX=360
AGENT_BATTEMENT_DEFAUT=60
AGENT_DEBOUNCE=15

# Claude Code : jeton d'abonnement (`claude setup-token`) ou clé API.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Canal vers l'opérateur.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sa boîte mail.
MAIL_ADRESSE=
MAIL_MOT_DE_PASSE=
MAIL_IMAP_HOTE=
MAIL_SMTP_HOTE=
MAIL_INTERVALLE=60

# Sa carte. Plafond dur 80 €. Jamais écrit dans un fichier du dépôt.
CARTE_NUMERO=
CARTE_EXP=
CARTE_CVC=

# Webhook d'encaissement.
AGENT_WEBHOOK_PORT=8787
AGENT_WEBHOOK_JETON=

# Triage à trois niveaux. Un modèle bon marché lit le plan en lecture seule et
# répond RIEN / SIMPLE / PLEIN. C'est le principal levier de coût du dispositif.
# AGENT_TRIAGE=0 le désactive (tout part alors en AGENT_MODELE).
AGENT_TRIAGE=1
AGENT_MODELE_TRIAGE=claude-haiku-4-5-20251001
AGENT_MODELE_SIMPLE=claude-sonnet-5

# ---- Passage par OpenRouter (optionnel) ----
# Apporte plafond de dépense, bascule automatique en cas d'indisponibilité, et
# un tableau de bord d'usage. Garde des modèles Anthropic : Claude Code n'est
# garanti qu'avec le fournisseur Anthropic de première partie.
# Noter les trois points : base sans /v1, jeton dans AUTH_TOKEN, et API_KEY
# explicitement vide.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-...
# ANTHROPIC_API_KEY=
# Les identifiants de modèle prennent alors le préfixe du fournisseur :
# AGENT_MODELE=anthropic/claude-opus-5
# AGENT_MODELE_SIMPLE=anthropic/claude-sonnet-5
# AGENT_MODELE_TRIAGE=anthropic/claude-haiku-4.5

# Détection de boucle : au-delà de N réveils sans rien produire hors de etat/,
# le superviseur impose un réveil de constat et élargit la cadence à 2 h.
AGENT_SEUIL_BOUCLE=5
# Audit de mémoire : tous les N réveils, passe de vérification de l'index.
AGENT_PERIODE_AUDIT=20

# Budget modèle, en dollars de jetons. C'est le vrai budget de l'expérience —
# celui de l'opérateur, pas les 80 € de l'agent. Exposé à l'agent dans
# etat/cout.json pour qu'il puisse arbitrer sa cadence en connaissance.
AGENT_BUDGET_MODELE=150
# Volume minimal (lignes) pour qu'un commit hors etat/ compte comme production.
AGENT_SEUIL_RITUEL=20

# Digest quotidien : heure UTC de la passe qui extrait la matière du récit
# public. Vide pour désactiver.
AGENT_HEURE_DIGEST=6
